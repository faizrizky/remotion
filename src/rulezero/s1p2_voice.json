{
 "pieces": [
  {
   "id": "A1",
   "role": "nar",
   "at": 0.35,
   "dur": 7.615,
   "text": "Dale is at the door. It won't open. Something tall is standing in the glass. You have two choices."
  },
  {
   "id": "A2",
   "role": "nar",
   "at": 8.765,
   "dur": 1.41,
   "text": "You tell him to run."
  },
  {
   "id": "G",
   "role": "you",
   "at": 10.525,
   "dur": 4.425,
   "text": "Get out of there. Someone's standing behind that door. Go. Now."
  },
  {
   "id": "A3",
   "role": "nar",
   "at": 15.3,
   "dur": 12.375,
   "text": "Dale doesn't ask. He runs. Behind him, something steps out of the doorway. Slowly. The lights go out. One row at a time. Your radio clicks."
  },
  {
   "id": "H",
   "role": "dale",
   "at": 27.975,
   "dur": 2.13,
   "text": "Hey. Someone's behind me."
  },
  {
   "id": "A4",
   "role": "nar",
   "at": 30.455,
   "dur": 5.625,
   "text": "He turns. He stops. Two small lights, an arm's length from his face."
  },
  {
   "id": "N1",
   "role": "dale",
   "at": 36.33,
   "dur": 1.514,
   "text": "No. No, no, no..."
  },
  {
   "id": "N2",
   "role": "dale",
   "at": 37.864,
   "dur": 1.466,
   "text": "Nooo!"
  },
  {
   "id": "A5",
   "role": "nar",
   "at": 39.63,
   "dur": 2.745,
   "text": "The radio hits the floor. Static."
  },
  {
   "id": "A6",
   "role": "nar",
   "at": 43.875,
   "dur": 4.75,
   "text": "The last thing Dale sees is the tall one, kneeling over him."
  },
  {
   "id": "A7",
   "role": "nar",
   "at": 49.075,
   "dur": 4.256,
   "text": "You told him to run. It was faster. You rewind."
  },
  {
   "id": "B",
   "role": "nar",
   "at": 55.031,
   "dur": 19.543,
   "text": "You tell him to open it. Dale pushes. The door swings in. He sees an empty landing. You see the tall one, close enough to touch him. Dale steps through. The door closes behind him. On camera three-A, he walks alone between the cars."
  },
  {
   "id": "K",
   "role": "dale",
   "at": 74.974,
   "dur": 2.05,
   "text": "Sedan's unlocked. Keys inside."
  },
  {
   "id": "T1",
   "role": "you",
   "at": 77.324,
   "dur": 1.175,
   "text": "Don't touch it."
  },
  {
   "id": "T2",
   "role": "dale",
   "at": 78.799,
   "dur": 1.635,
   "text": "Just turning off the lights."
  },
  {
   "id": "C1",
   "role": "nar",
   "at": 81.234,
   "dur": 11.61,
   "text": "He gets in. The door shuts. The headlights go out. In the dark, the driver's seat is no longer Dale's. Same uniform. Same cap. A different face."
  },
  {
   "id": "C2",
   "role": "nar",
   "at": 93.844,
   "dur": 11.896,
   "text": "The sedan backs out of bay thirty-one. No brake lights. Back to bay twelve. Behind the glass, Dale smiles. He waves. It isn't his smile."
  },
  {
   "id": "D1",
   "role": "nar",
   "at": 107.24,
   "dur": 6.325,
   "text": "Six a.m. You write the last entry. Bay thirty-one to bay twelve. Dale."
  },
  {
   "id": "D2",
   "role": "nar",
   "at": 115.265,
   "dur": 5.675,
   "text": "Under the monitor, a torn strip of paper taped to the wall. Rule three."
  },
  {
   "id": "D3",
   "role": "nar",
   "at": 121.34,
   "dur": 2.7,
   "text": "Whoever goes up is logged as a car."
  },
  {
   "id": "D4",
   "role": "nar",
   "at": 125.44,
   "dur": 4.325,
   "text": "The line below Dale's name is already filled in. It's yours."
  },
  {
   "id": "D5",
   "role": "nar",
   "at": 131.365,
   "dur": 2.31,
   "text": "In the booth door, two small lights."
  },
  {
   "id": "D6",
   "role": "nar",
   "at": 134.575,
   "dur": 6.456,
   "text": "Rule one, followed. Rule two, broken. Rule three. Now you know."
  }
 ],
